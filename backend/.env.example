# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tinta
DB_PASSWORD=<strong-password>
DB_NAME=tinta_lab

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://app.tinta-lab.de

# ─── Auth ─────────────────────────────────────────────────────────────────────
# User JWT (15 min access tokens)
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRES_IN=15m
# Refresh token (7 days)
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_EXPIRES_IN=7d
# Agent JWT (1 year — generated per-client via /tinta-core/provision/:clientId)
AGENT_JWT_SECRET=<generate: openssl rand -hex 32>

# ─── Cloudflare (optional — enables auto-tunnel provisioning) ──────────────────
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_BASE_DOMAIN=tinta-lab.de

# ─── Telegram notifications (optional) ───────────────────────────────────────
# Create a bot via @BotFather, then get the chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Support access ───────────────────────────────────────────────────────────
# How long (minutes) before support access auto-expires (used when the client
# doesn't pick a duration tier — the client dashboard offers 15/30/60)
SUPPORT_ACCESS_TIMEOUT=60

# GDPR retention: how many days a closed access_log is kept before the nightly
# purge job deletes it. Sessions still open, or flagged with a retention hold
# (litigation/incident), are never purged regardless of age.
AUDIT_LOG_RETENTION_DAYS=365
